# Copy to .env and fill in. .env is gitignored — never commit a real key.
# Get a free key (signed in with your own Google account): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Confirm this name with:  .venv\Scripts\python -m src.gemini --list-models
GEMINI_MODEL=gemini-3.5-flash
# MINIMAL keeps replies inside the 5 s timeout; leave empty for models that reject it
GEMINI_THINKING_LEVEL=MINIMAL
# Set to 1 to force the deterministic fallback (demo/testing without network)
GEMINI_FORCE_FAIL=0
